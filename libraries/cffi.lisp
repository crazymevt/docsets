;;;; cffi.lisp — the foreign function interface
;;;;
;;;; From the Texinfo manual in doc/cffi-manual.texinfo, which documents the
;;;; API a node per definition, laid out like the standard, among chapters
;;;; of tutorial and concepts; from docstrings for what it leaves out; and
;;;; from the README.

(define-library "cffi"
  :title "CFFI"
  :subtitle "The Common Foreign Function Interface"
  :source "https://github.com/cffi/cffi"
  :license "MIT"
  :attribution "From the CFFI User Manual, CFFI's docstrings and its README, by James Bielman, Luis Oliveira and the CFFI contributors."
  :readme "README.md"
  :texinfo "doc/cffi-manual.texinfo"
  :packages ("CFFI"))
