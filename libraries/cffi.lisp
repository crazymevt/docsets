;;;; cffi.lisp — the foreign function interface
;;;;
;;;; From docstrings and the README. A third of CFFI's symbols have no
;;;; docstring, so those entries have their syntax only; its full reference
;;;; is the Texinfo manual in doc/cffi-manual.texinfo, which this doesn't read.

(define-library "cffi"
  :title "CFFI"
  :subtitle "The Common Foreign Function Interface"
  :source "https://github.com/cffi/cffi"
  :license "MIT"
  :attribution "From CFFI's docstrings and README, by James Bielman, Luis Oliveira and the CFFI contributors."
  :readme "README.md"
  :packages ("CFFI"))
